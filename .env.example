# Template only — copy to .env and fill in real values locally.
# Never commit real secrets, credentials, or DSNs.

# DB_MODE=postgres fails hard when the database is unreachable (active below).
# DB_MODE=auto probes PostgreSQL, then falls back to SQLite if unreachable.
# DB_MODE=sqlite forces offline mode (auth plus full business schema).
DB_MODE=postgres

# Local development PostgreSQL 17, already running (make dev/seed default to
# this when DB_MODE/DATABASE_URL are unset). The app uses the non-superuser
# project role `inventory` on database `inventory_desktop`. The admin role
# `postgres`/`postgres` is only for administration. On first start the init
# script creates the role and database. Data lives in the fresh
# postgresql_postgres_data_pg17 volume; the previous PG16 volume was deleted.
DATABASE_URL=postgresql://inventory:inventory@127.0.0.1:5432/inventory_desktop
# Optional compose PostgreSQL 17 on port 5433 (start it with `make db-up`):
# DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory_desktop
# Optional. Defaults to <OS config dir>/inventory-desktop/data/inventory.sqlite
SQLITE_PATH=
# Leave blank locally: the app generates a secret on first run and persists it
# in the OS config directory. Release installs must set a 32+ byte random
# secret, for example: openssl rand -base64 48
# The old placeholder string is rejected at startup.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
AUTO_MIGRATE=true
LOG_LEVEL=info
VITE_API_URL=http://127.0.0.1:8787/api/v1
