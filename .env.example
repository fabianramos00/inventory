# Template only — copy to .env and fill in real values locally.
# Never commit real secrets, credentials, or DSNs.

DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory_desktop
# Leave blank locally: the app generates a secret on first run and persists it
# in the OS config directory. Release installs must set a 32+ byte random
# secret, for example: openssl rand -base64 48
# The old placeholder string is rejected at startup.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
AUTO_MIGRATE=true
LOG_LEVEL=info
VITE_API_URL=http://127.0.0.1:8787/api/v1
